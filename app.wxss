/* 全局样式 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', Arial, sans-serif;
  background-color: #f5f5f5;
  color: #333333;
}

.container {
  padding: 30rpx;
  box-sizing: border-box;
}

/* 表单样式 */
.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 28rpx;
  color: #666666;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background-color: #ffffff;
  border: 1rpx solid #dddddd;
  border-radius: 8rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

/* 按钮样式 */
.btn {
  width: 100%;
  height: 90rpx;
  border-radius: 45rpx;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.btn-primary {
  background-color: #1a73e8;
  color: #ffffff;
}

.btn-secondary {
  background-color: #ffffff;
  color: #1a73e8;
  border: 1rpx solid #1a73e8;
}

.btn-disabled {
  background-color: #cccccc;
  color: #ffffff;
}

/* 消息提示 */
.message {
  padding: 20rpx;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
  font-size: 26rpx;
}

.message-error {
  background-color: #fff2f0;
  color: #f5222d;
  border: 1rpx solid #ffccc7;
}

.message-success {
  background-color: #f6ffed;
  color: #52c41a;
  border: 1rpx solid #b7eb8f;
}

/* 链接样式 */
.link {
  color: #1a73e8;
  font-size: 28rpx;
  text-decoration: none;
}

/* 头部样式 */
.header {
  padding: 60rpx 0 40rpx;
  text-align: center;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 30rpx;
  border-radius: 20rpx;
  background-color: #1a73e8;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #666666;
}