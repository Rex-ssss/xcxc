<!-- pages/register/register.wxml -->
<view class="container">
  <view class="header">
    <view class="title">用户注册</view>
  </view>
  
  <!-- 错误提示 -->
  <view wx:if="{{errorMessage}}" class="message message-error">
    {{errorMessage}}
  </view>
  
  <!-- 注册表单 -->
  <view class="form">
    <view class="form-item">
      <view class="form-label">学号 <text style="color: #f5222d;">*</text></view>
      <input 
        class="form-input" 
        type="text" 
        placeholder="请输入学号" 
        value="{{studentId}}" 
        bindinput="inputStudentId"
      />
    </view>
    
    <view class="form-item">
      <view class="form-label">姓名 <text style="color: #f5222d;">*</text></view>
      <input 
        class="form-input" 
        type="text" 
        placeholder="请输入姓名" 
        value="{{name}}" 
        bindinput="inputName"
      />
    </view>
    
    <view class="form-item">
      <view class="form-label">手机号 <text style="color: #f5222d;">*</text></view>
      <input 
        class="form-input" 
        type="number" 
        placeholder="请输入手机号" 
        value="{{phone}}" 
        bindinput="inputPhone"
      />
    </view>
    
    <view class="form-item">
      <view class="form-label">验证码 <text style="color: #f5222d;">*</text></view>
      <view style="display: flex;">
        <input 
          class="form-input" 
          style="flex: 1; margin-right: 20rpx;" 
          type="number" 
          placeholder="请输入验证码" 
          value="{{verificationCode}}" 
          bindinput="inputVerificationCode"
        />
        <button 
          class="btn btn-secondary"
          style="flex: 0 0 220rpx; height: 80rpx;"
          bindtap="sendVerificationCode"
          disabled="{{!canSendCode}}"
        >
          {{countdown > 0 ? countdown + '秒后重发' : '获取验证码'}}
        </button>
      </view>
    </view>
    
    <view class="form-item">
      <view class="form-label">邮箱 <text style="color: #f5222d;">*</text></view>
      <input 
        class="form-input" 
        type="text" 
        placeholder="请输入邮箱" 
        value="{{email}}" 
        bindinput="inputEmail"
      />
    </view>
    
    <view class="form-item">
      <view class="form-label">密码 <text style="color: #f5222d;">*</text></view>
      <input 
        class="form-input" 
        type="password" 
        placeholder="请设置密码（不少于6位）" 
        value="{{password}}" 
        bindinput="inputPassword"
      />
    </view>
    
    <view class="form-item">
      <view class="form-label">确认密码 <text style="color: #f5222d;">*</text></view>
      <input 
        class="form-input" 
        type="password" 
        placeholder="请再次输入密码" 
        value="{{confirmPassword}}" 
        bindinput="inputConfirmPassword"
      />
    </view>
    
    <button 
      class="btn btn-primary" 
      bindtap="registerSubmit"
      loading="{{isLoading}}"
      disabled="{{isLoading}}"
    >
      注册
    </button>
    
    <view style="text-align: center; margin-top: 30rpx;">
      <text>已有账号？</text>
      <text class="link" bindtap="goToLogin"> 立即登录</text>
    </view>
  </view>
</view>