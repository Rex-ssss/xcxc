<!-- pages/publish/publish.wxml -->
<view class="container">
  <!-- 未登录提示 -->
  <view wx:if="{{!isLogin}}" class="not-login">
    <view class="login-icon" style="width: 120rpx; height: 120rpx; background-color: #f0f0f0; border-radius: 60rpx; margin: 0 auto 30rpx;"></view>
    <view class="login-text" style="text-align: center; font-size: 32rpx; color: #666666; margin-bottom: 40rpx;">请先登录发布商品</view>
    <button class="btn btn-primary" bindtap="goToLogin">立即登录</button>
  </view>

  <!-- 发布表单 -->
  <form wx:else bindsubmit="submitPublish" class="publish-form">
    <!-- 商品标题 -->
    <view class="form-item">
      <view class="form-label" style="font-size: 32rpx; color: #333333; margin-bottom: 20rpx;">商品标题</view>
      <input class="form-input" type="text" placeholder="请输入商品标题" value="{{title}}" bindinput="inputTitle" style="width: 100%; height: 80rpx; border: 1rpx solid #e0e0e0; border-radius: 8rpx; padding: 0 20rpx; font-size: 30rpx;"/>
    </view>

    <!-- 商品描述 -->
    <view class="form-item">
      <view class="form-label" style="font-size: 32rpx; color: #333333; margin-bottom: 20rpx;">商品描述</view>
      <textarea class="form-textarea" placeholder="请输入商品描述" value="{{description}}" bindinput="inputDescription" style="width: 100%; height: 200rpx; border: 1rpx solid #e0e0e0; border-radius: 8rpx; padding: 20rpx; font-size: 30rpx;"/>
    </view>

    <!-- 商品价格 -->
    <view class="form-item">
      <view class="form-label" style="font-size: 32rpx; color: #333333; margin-bottom: 20rpx;">商品价格</view>
      <input class="form-input" type="digit" placeholder="请输入商品价格" value="{{price}}" bindinput="inputPrice" style="width: 100%; height: 80rpx; border: 1rpx solid #e0e0e0; border-radius: 8rpx; padding: 0 20rpx; font-size: 30rpx;"/>
    </view>

    <!-- 商品分类 -->
    <view class="form-item">
      <view class="form-label" style="font-size: 32rpx; color: #333333; margin-bottom: 20rpx;">商品分类</view>
      <picker class="form-picker" bindchange="selectCategory" value="{{category}}" range="{{categoryOptions}}" style="width: 100%; height: 80rpx; border: 1rpx solid #e0e0e0; border-radius: 8rpx; padding: 0 20rpx; display: flex; align-items: center;">
        <view wx:if="{{category}}" style="font-size: 30rpx;">{{category}}</view>
        <view wx:else style="font-size: 30rpx; color: #999999;">请选择商品分类（如教材/电子产品）</view>
      </picker>
    </view>

    <!-- 新旧程度 -->
    <view class="form-item">
      <view class="form-label" style="font-size: 32rpx; color: #333333; margin-bottom: 20rpx;">新旧程度</view>
      <picker class="form-picker" bindchange="selectCondition" value="{{condition}}" range="{{conditionOptions}}" style="width: 100%; height: 80rpx; border: 1rpx solid #e0e0e0; border-radius: 8rpx; padding: 0 20rpx; display: flex; align-items: center;">
        <view wx:if="{{condition}}" style="font-size: 30rpx;">{{condition}}</view>
        <view wx:else style="font-size: 30rpx; color: #999999;">请选择新旧程度（如9成新）</view>
      </picker>
    </view>

    <!-- 商品图片 -->
    <view class="form-item">
      <view class="form-label" style="font-size: 32rpx; color: #333333; margin-bottom: 20rpx;">需上传 3-9 张实物图</view>
      <view class="image-list" style="display: flex; flex-wrap: wrap; gap: 20rpx;">
        <view wx:for="{{images}}" wx:key="index" class="image-item" style="position: relative; width: 200rpx; height: 200rpx;">
          <image src="{{item}}" mode="aspectFill" bindtap="previewImage" data-index="{{index}}" style="width: 100%; height: 100%; border-radius: 8rpx;"></image>
          <view class="delete-btn" bindtap="deleteImage" data-index="{{index}}" style="position: absolute; top: -10rpx; right: -10rpx; width: 40rpx; height: 40rpx; background-color: rgba(0, 0, 0, 0.5); color: #ffffff; border-radius: 20rpx; display: flex; align-items: center; justify-content: center; font-size: 24rpx;">×</view>
        </view>
        <view wx:if="{{images.length < 9}}" class="add-image" bindtap="chooseImage" style="width: 200rpx; height: 200rpx; border: 1rpx dashed #e0e0e0; border-radius: 8rpx; display: flex; align-items: center; justify-content: center;">
          <view style="text-align: center;">
            <view style="font-size: 48rpx; color: #999999; margin-bottom: 10rpx;">+</view>
            <view style="font-size: 24rpx; color: #999999;">添加图片</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 操作按钮区：预览 + 提交 -->
    <view style="display: flex; gap: 20rpx; margin-top: 40rpx;">
      <button class="btn btn-secondary" bindtap="openPreview" style="flex: 1; height: 90rpx; line-height: 90rpx; font-size: 34rpx; border: 1rpx solid #e0e0e0;">预览</button>
      <button class="btn btn-primary submit-btn" type="primary" form-type="submit" loading="{{isLoading}}" style="flex: 1; height: 90rpx; line-height: 90rpx; font-size: 34rpx;">提交发布</button>
    </view>

    <!-- 预览面板 -->
    <view wx:if="{{previewVisible}}" style="position: fixed; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(0,0,0,0.4); display: flex; align-items: center; justify-content: center; z-index: 999;">
      <view style="width: 86%; max-height: 80%; overflow-y: auto; background-color: #ffffff; border-radius: 16rpx; padding: 30rpx;">
        <view style="font-size: 34rpx; font-weight: 600; margin-bottom: 20rpx;">发布内容预览</view>
        <view style="font-size: 28rpx; color: #333; margin-bottom: 10rpx;">名称：{{title || '（未填写）'}}</view>
        <view style="font-size: 28rpx; color: #333; margin-bottom: 10rpx;">分类：{{category || '（未选择）'}}</view>
        <view style="font-size: 28rpx; color: #333; margin-bottom: 10rpx;">价格：{{price || '（未填写）'}} 元</view>
        <view style="font-size: 28rpx; color: #333; margin-bottom: 10rpx;">新旧程度：{{condition || '（未选择）'}}</view>
        <view style="font-size: 28rpx; color: #333; margin-bottom: 10rpx;">描述：{{description || '（未填写）'}}</view>
        <view style="font-size: 28rpx; color: #333; margin: 20rpx 0 10rpx;">图片（已选 {{images.length}} 张）：</view>
        <view style="display: flex; flex-wrap: wrap; gap: 10rpx;">
          <image wx:for="{{images}}" wx:key="index" src="{{item}}" mode="aspectFill" style="width: 160rpx; height: 160rpx; border-radius: 12rpx;"></image>
        </view>
        <view style="margin-top: 30rpx; display: flex; gap: 20rpx;">
          <button class="btn btn-secondary" bindtap="closePreview" style="flex: 1; height: 80rpx; line-height: 80rpx; font-size: 30rpx; border: 1rpx solid #e0e0e0;">关闭预览</button>
          <button class="btn btn-primary" bindtap="submitPublish" style="flex: 1; height: 80rpx; line-height: 80rpx; font-size: 30rpx;">确认提交</button>
        </view>
      </view>
    </view>
  </form>
</view>