<!-- pages/cart/cart.wxml -->
<view class="container">
  <!-- 未登录提示 -->
  <view wx:if="{{!isLogin}}" class="not-login">
    <view class="login-icon" style="width: 120rpx; height: 120rpx; background-color: #f0f0f0; border-radius: 60rpx; margin: 0 auto 30rpx;"></view>
    <view class="login-text" style="text-align: center; font-size: 32rpx; color: #666666; margin-bottom: 40rpx;">请先登录查看购物车</view>
    <button class="btn btn-primary" bindtap="goToLogin">立即登录</button>
  </view>

  <!-- 购物车内容 -->
  <view wx:elif="{{isLoading}}" class="loading">
    <view>加载中...</view>
  </view>

  <!-- 购物车为空 -->
  <view wx:elif="{{cartItems.length === 0}}" class="empty-cart">
    <view class="empty-icon" style="width: 120rpx; height: 120rpx; background-color: #f0f0f0; border-radius: 60rpx; margin: 0 auto 30rpx;"></view>
    <view class="empty-text" style="text-align: center; font-size: 32rpx; color: #666666;">购物车是空的</view>
  </view>

  <!-- 购物车商品列表 -->
  <view wx:else class="cart-content">
    <!-- 商品列表 -->
    <view class="cart-list">
      <view class="cart-item" wx:for="{{cartItems}}" wx:key="id">
        <view class="item-image" style="width: 180rpx; height: 180rpx; background-color: #f8f8f8; margin-right: 30rpx;"></view>
        <view class="item-info" style="flex: 1;">
          <view class="item-title" style="font-size: 30rpx; color: #333333; margin-bottom: 10rpx; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">{{item.title}}</view>
          <view class="item-price" style="font-size: 32rpx; color: #ff6b81; margin-bottom: 20rpx;">¥{{item.price}}</view>
          <view class="item-control" style="display: flex; align-items: center;">
            <view class="quantity-control" style="display: flex; align-items: center; border: 1rpx solid #e0e0e0; border-radius: 8rpx;">
              <view class="btn-minus" bindtap="decreaseQuantity" data-index="{{index}}" style="width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center;">-</view>
              <view class="quantity" style="width: 80rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; border-left: 1rpx solid #e0e0e0; border-right: 1rpx solid #e0e0e0;">{{item.quantity}}</view>
              <view class="btn-plus" bindtap="increaseQuantity" data-index="{{index}}" style="width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center;">+</view>
            </view>
            <view class="btn-delete" bindtap="removeFromCart" data-index="{{index}}" style="margin-left: 30rpx; color: #999999;">删除</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部结算栏 -->
    <view class="checkout-bar" style="position: fixed; bottom: 0; left: 0; right: 0; background-color: #ffffff; border-top: 1rpx solid #e0e0e0; padding: 20rpx 30rpx;">
      <view class="total-info" style="flex: 1;">
        <view class="total-text" style="font-size: 28rpx; color: #666666;">合计：</view>
        <view class="total-price" style="font-size: 36rpx; color: #ff6b81; font-weight: bold;">¥{{totalPrice.toFixed(2)}}</view>
      </view>
      <button class="btn btn-primary checkout-btn" bindtap="checkout" style="padding: 0 60rpx;">结算</button>
    </view>
  </view>
</view>