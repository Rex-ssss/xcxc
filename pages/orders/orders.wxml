<!-- pages/orders/orders.wxml -->
<view class="container">
  <!-- 未登录提示 -->
  <view wx:if="{{!isLogin}}" class="not-login">
    <view class="login-icon" style="width: 120rpx; height: 120rpx; background-color: #f0f0f0; border-radius: 60rpx; margin: 0 auto 30rpx;"></view>
    <view class="login-text" style="text-align: center; font-size: 32rpx; color: #666666; margin-bottom: 40rpx;">请先登录查看订单</view>
    <button class="btn btn-primary" bindtap="goToLogin">立即登录</button>
  </view>

  <view wx:else>
    <!-- 订单状态标签栏 -->
    <view class="tab-bar" style="display: flex; background-color: #ffffff; border-bottom: 1rpx solid #e0e0e0; position: sticky; top: 0; z-index: 10;">
      <view wx:for="{{tabs}}" wx:key="index" class="tab-item {{activeTab === index ? 'active' : ''}}" bindtap="switchTab" data-index="{{index}}" style="flex: 1; text-align: center; padding: 30rpx 0; font-size: 30rpx; {{activeTab === index ? 'color: #1a73e8; border-bottom: 4rpx solid #1a73e8;' : 'color: #666666;'}}">
        {{item}}
      </view>
    </view>

    <!-- 加载中 -->
    <view wx:if="{{isLoading}}" class="loading">
      <view>加载中...</view>
    </view>

    <!-- 订单为空 -->
    <view wx:elif="{{filteredOrders.length === 0}}" class="empty-orders">
      <view class="empty-icon" style="width: 120rpx; height: 120rpx; background-color: #f0f0f0; border-radius: 60rpx; margin: 0 auto 30rpx;"></view>
      <view class="empty-text" style="text-align: center; font-size: 32rpx; color: #666666;">暂无订单</view>
    </view>

    <!-- 订单列表 -->
    <view wx:else>
      <!-- 管理栏：管理/完成 + （管理模式下）删除所有订单 -->
      <view class="manage-bar">
        <button class="btn btn-mini manage-btn" bindtap="toggleManageMode">
          {{manageMode ? '完成' : '管理'}}
        </button>
        <button wx:if="{{manageMode}}" class="btn btn-mini delete-all-btn" bindtap="deleteAllOrders">删除所有订单</button>
      </view>

      <view class="order-list">
      <view wx:for="{{filteredOrders}}" wx:key="id" class="order-item">
        <!-- 订单头部 -->
        <view class="order-header" style="display: flex; justify-content: space-between; margin-bottom: 20rpx; padding-bottom: 20rpx; border-bottom: 1rpx solid #f0f0f0;">
          <view class="order-id" style="font-size: 28rpx; color: #666666;">订单号：{{item.id}}</view>
          <view class="order-status" style="font-size: 28rpx; color: #ff6b81;">{{item.status}}</view>
        </view>

        <!-- 订单商品 -->
        <view wx:for="{{item.items}}" wx:for-item="product" wx:key="id" class="order-product">
          <view class="product-image" style="width: 120rpx; height: 120rpx; background-color: #f8f8f8; margin-right: 20rpx;"></view>
          <view class="product-info" style="flex: 1;">
            <view class="product-title">{{product.title}}</view>
            <view class="product-price-quantity" style="display: flex; justify-content: space-between;">
              <view class="product-price" style="font-size: 30rpx; color: #ff6b81;">¥{{product.price}}</view>
              <view class="product-quantity" style="font-size: 28rpx; color: #999999;">x{{product.quantity}}</view>
            </view>
          </view>
          <!-- 管理模式下显示删除商品按钮（柔和样式） -->
          <button wx:if="{{manageMode}}" class="btn delete-item-btn" bindtap="deleteOrderItem" data-order-id="{{item.id}}" data-product-id="{{product.id}}">删除</button>
        </view>

        <!-- 订单金额 -->
        <view class="order-amount" style="display: flex; justify-content: flex-end; margin-bottom: 20rpx;">
          <view class="amount-label" style="font-size: 28rpx; color: #666666; margin-right: 10rpx;">合计：</view>
          <view class="amount-value" style="font-size: 32rpx; color: #333333; font-weight: bold;">¥{{item.totalPrice}}</view>
        </view>

        <!-- 订单操作：统一圆角与尺寸，通过 orders.wxss 控制颜色与边框 -->
        <view class="order-actions" style="display: flex; justify-content: flex-end; gap: 20rpx;">
          <button wx:if="{{item.status === '待付款'}}" class="btn btn-secondary btn-mini" bindtap="cancelOrder" data-id="{{item.id}}">取消订单</button>
          <button wx:if="{{item.status === '待付款'}}" class="btn btn-primary btn-mini" bindtap="payOrder" data-id="{{item.id}}">立即付款</button>
          <button wx:if="{{item.status === '待收货'}}" class="btn btn-primary btn-mini" bindtap="confirmReceipt" data-id="{{item.id}}">确认收货</button>
          <button class="btn btn-secondary btn-mini" bindtap="viewOrderDetail" data-id="{{item.id}}">查看详情</button>
        </view>
      </view>
      </view>
    </view>
  </view>
</view>