<!-- pages/dashboard/dashboard.wxml -->
<view class="container">
  <!-- 用户信息区域 -->
  <view class="user-info" style="background-color: #1a73e8; color: #ffffff; padding: 40rpx; border-radius: 16rpx; margin-bottom: 30rpx;">
    <view class="avatar" style="width: 120rpx; height: 120rpx; background-color: rgba(255, 255, 255, 0.2); border-radius: 60rpx; margin: 0 auto 20rpx;"></view>
    <view class="user-name" style="text-align: center; font-size: 36rpx; font-weight: bold;">{{userInfo.name}}</view>
    <view class="user-id" style="text-align: center; font-size: 28rpx; opacity: 0.8; margin-top: 10rpx;">{{userInfo.studentId}}</view>
  </view>
  
  <!-- 功能中心 -->
  <view class="function-center" style="background-color: #ffffff; border-radius: 16rpx; padding: 30rpx 0;">
    <view class="function-item" style="display: flex; align-items: center; padding: 30rpx; border-bottom: 1rpx solid #f0f0f0;" bindtap="goToTrading">
      <view class="function-icon" style="width: 56rpx; height: 56rpx; background-color: #e3f2fd; border-radius: 12rpx; margin-right: 30rpx;"></view>
      <view class="function-text" style="font-size: 32rpx; flex: 1;">二手交易</view>
      <view class="function-arrow" style="color: #cccccc;">→</view>
    </view>
    
    <view class="function-item" style="display: flex; align-items: center; padding: 30rpx;" bindtap="goToSettings">
      <view class="function-icon" style="width: 56rpx; height: 56rpx; background-color: #fff3e0; border-radius: 12rpx; margin-right: 30rpx;"></view>
      <view class="function-text" style="font-size: 32rpx; flex: 1;">个人设置</view>
      <view class="function-arrow" style="color: #cccccc;">→</view>
    </view>
  </view>
  
  <!-- 退出登录按钮 -->
  <button 
    class="btn btn-secondary" 
    style="margin-top: 40rpx;"
    bindtap="logout"
  >
    退出登录
  </button>
</view>